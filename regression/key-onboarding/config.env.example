# Copy to config.env.

# Core, and the administrator certificate sent in the ssl-client-cert header.
ILM_HOST=http://localhost:8080
ADMIN_CERT_PEM=/path/to/admin.cert.pem
# Against an ingress that terminates TLS, present a PKCS#12 over mTLS instead.
# ADMIN_CLIENT_P12=/path/to/admin.p12
# ADMIN_CLIENT_P12_PASSWORD=

# Connector URLs as Core reaches them.
PKCS11_CONNECTOR_URL=http://localhost:8290
VAULT_CONNECTOR_URL=http://localhost:8200

# The connector's config profile, the label of the token on it, and the token's user PIN.
PKCS11_PROFILE=softhsm
PKCS11_TOKEN=softhsm
TOKEN_PIN=1234

# The running SoftHSM sidecar whose token the suite plants key pairs on.
SIDECAR_CONTAINER=pkcs11-sidecar-softhsm
