# Timestamping regression suite configuration.
# Copy to config.env and adjust. config.env is gitignored: it names local files and
# carries the EJBCA bundle password.

# --- Component sources --------------------------------------------------------
# Every component is taken from the registry unless it is listed here. Comma-separated;
# 'all' means every component except the platform ones (auth, scheduler, opa-bundle-server),
# which have to be named explicitly. Override per run with --local / --published.
#LOCAL_COMPONENTS=all
#LOCAL_COMPONENTS=interfaces,core

# Which published build to use: develop (the head of main), release (the newest tag), or a
# literal tag such as develop-<sha>.
#PUBLISHED_REF=develop
#PUBLISHED_REGISTRY=hub.omnitrustregistry.com
# Pin one component, whatever PUBLISHED_REF says.
#PUBLISHED_TAG_core=2.20.0
# Repoint one component at a different image, registry included.
#PUBLISHED_IMAGE_opa_bundle_server=harbor.3key.company/czertainly/czertainly-auth-opa-policies

# --- Workspace ----------------------------------------------------------------
# Directory holding the checkouts the suite drives, development-environment among them.
# Defaults to the parent of this automated-testing-framework checkout, which is also correct
# when this checkout sits inside a development-environment working tree.
#WORKSPACE_DIR=/path/to/workspace

# Where --clone fetches missing repositories from.
#GIT_REMOTE_BASE=git@github.com:OmniTrustILM
#GIT_REMOTE_BASE=https://github.com/OmniTrustILM
# Per-repository override, if one of them lives on a different remote.
#REPO_URL_core=git@github.com:OmniTrustILM/core.git

# Administrator certificate (PEM) presented to Core in the ssl-client-cert header.
ADMIN_CERT_PEM=/path/to/admin.cert.pem

# EJBCA client PKCS12 bundle backing the SoftKeyStore credential used for certificate issuance.
EJBCA_PKCS12_BUNDLE=/path/to/ejbca-client.p12
EJBCA_PKCS12_PASSWORD=00000000

# Core. A locally built Core runs on the host on CORE_PORT; a published one runs as the
# Compose service and is reached on CORE_CONTAINER_PORT. ILM_HOST follows from whichever
# applies — set it only to point the suite at a Core it does not manage.
CORE_PORT=8080
#CORE_CONTAINER_PORT=8280
#ILM_HOST=http://localhost:8080
# DEBUG makes Core's own timestamping decisions visible in runs/<run>/core.log.
CORE_LOG_LEVEL=INFO

# Toolchain overrides, if the defaults on PATH are not the ones to use. Only needed when
# interfaces or core is built locally.
#JAVA_BIN=java
#MVN_BIN=mvn

# Checkout locations, for locally sourced components. The runner finds <repo> and <repo>-*
# under WORKSPACE_DIR on its own; set these only for checkouts living somewhere else.
#REPO_DIR_core=/path/to/core
#REPO_DIR_interfaces=/path/to/interfaces
#REPO_DIR_timestamp_formatting_connector=/path/to/timestamp-formatting-connector
#REPO_DIR_time_quality_monitor=/path/to/time-quality-monitor
