{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "tests",
    "fixtures",
    "pages",
    "utils",
    "playwright.config.ts",
    "playwright.regression.config.ts",
    "playwright.api.config.ts",
    "playwright.unit.config.ts",
    "playwright.visual.config.ts"
  ]
}