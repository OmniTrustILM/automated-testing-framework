# Dedicated disposable product + issuer only. Copy to .env.delegation (gitignored).
DELEGATION_DISPOSABLE=true
DELEGATION_BASE_URL=https://ilm-disposable.example.test
DELEGATION_ADMIN_TOKEN=
# Existing enabled product user with permission for the audited GET and TSP profile below.
DELEGATION_USERNAME=delegation-test-user
DELEGATION_USER_UUID=
DELEGATION_API_PATH=/api/v1/settings/platform
# Optional scenario 2 evidence helper: an audited GET this user must receive 403 for.
# DELEGATION_DENIED_API_PATH=/api/v1/settings/authentication
DELEGATION_TSP_PATH=/api/v1/protocols/tsp/delegation-test-profile
# Must be reachable at the SAME issuer URL from both runner and Core.
DELEGATION_KEYCLOAK_URL=http://127.0.0.1:18818
DELEGATION_KEYCLOAK_ADMIN_USERNAME=admin
DELEGATION_KEYCLOAK_ADMIN_PASSWORD=
# Override only if export.separator was changed from the default comma.
DELEGATION_CSV_SEPARATOR=,
