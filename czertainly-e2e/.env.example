# === Base (Required) ===
# Frontend URL of the environment under test
BASE_URL=
# "local", "oidc" or "header" (header: a local stack only, the dev proxy adds the admin certificate)
AUTH_MODE=local
SMOKE_USERNAME=
SMOKE_PASSWORD=

# === Authentication ===
AUTH_CLIENT_ID=
SMOKE_CLIENT_SECRET=
AUTH_REALM=
# Optional — defaults to BASE_URL/kc
AUTH_BASE_URL=
LOCAL_AUTH_PROVIDER_NAME=Internal

# === Smoke mode ===
# Default (unset / =false): hermetic — globalSetup provisions per-run and
#   globalTeardown deletes everything. Right for CI.
# SMOKE_PERSIST=true: reuse mode for local iterative dev. First run provisions
#   and writes .smoke-state.json. Subsequent runs see the state file and skip
#   provisioning. globalTeardown is also skipped — state persists. When done,
#   manually delete .smoke-state.json (and clean entities in Core if needed).
#   NOTE: every smoke env var below must still be set — SMOKE_PERSIST only
#   affects state reuse, not validation.
SMOKE_PERSIST=

# === SMK-003: Network Discovery ===
# Registered name of the discovery connector. Required to match when several registrations share
# DISCOVERY_PROVIDER_URL (one per interface version); SMK-003 drives the v1 form.
DISCOVERY_PROVIDER_NAME=Network Discovery Provider
DISCOVERY_PROVIDER_URL=
DISCOVERY_TARGET=

# === SMK-004: Certificate Issuance ===
# Test creates Credential + Authority + RA Profile + Certificate per-run via API.
# Connector pods are auto-registered in Core if missing (handles cluster rebuilds).

EJBCA_CONNECTOR_NAME=EJBCA-NG-Connector
CREDENTIAL_CONNECTOR_NAME=Common-Credential-Connector

# Connector pod URLs (required) — cluster-internal Kubernetes Service URLs of the
# connector pods. Used to auto-register the connectors in ILM Core if missing
# (after cluster rebuild).
EJBCA_CONNECTOR_URL=
CREDENTIAL_CONNECTOR_URL=

# EJBCA target — required when running SMK-004
# Format: https://<host>/ejbca/ejbcaws/ejbcaws?wsdl
EJBCA_WS_URL=
EJBCA_CA_NAME=
EJBCA_END_ENTITY_PROFILE=
EJBCA_CERTIFICATE_PROFILE=

# Sensitive — never commit real values. Local: put in .env (gitignored). CI: use secrets.
# Generate base64: base64 -i admin.p12 | tr -d '\n'
EJBCA_P12_BASE64=
EJBCA_P12_PASSWORD=

# === SMK-005: ACME certificate issuance ===
# Namespace where the smoke test creates Issuer / Certificate / Secret
SMOKE_TESTS_NAMESPACE=testkube-runner
# Parent domain of the name the HTTP-01 solver answers on. The platform must resolve it to the
# ingress of the cluster the runner is in. Defaults to BASE_URL's host minus its first label.
ACME_SOLVER_DOMAIN=
# Ingress class for the solver's Ingress (default: nginx)
ACME_INGRESS_CLASS=
# Gateway in SMOKE_TESTS_NAMESPACE that routes the solver, for a cluster whose ingress controller
# serves Gateway API routes only. When set, the solver is an HTTPRoute and ACME_INGRESS_CLASS is unused.
ACME_SOLVER_GATEWAY=

# === k8s local access (optional) ===
# Path to kubeconfig file for local runs. Leave empty in Testkube — pod uses
# its own ServiceAccount token automatically.
KUBECONFIG_PATH=

# === REG-* / API-*: main-functionality regression and API suites (playwright.regression.config.ts, playwright.api.config.ts) ===
# Own objects only (decision Q1): the suites read everything, create run-prefixed objects and change only objects they
# created; anything that existed before the run is never changed, disabled, revoked or deleted. Everything a run creates
# is listed in $REG_STATE_DIR/created-objects.jsonl (default ~/.ilm-qa/regression-state, outside the clone) and deleted
# at the end of the run (decision D1). Names only below; never put values for a real tier into this file.
# REG_ENV_FILE=          # run against another tier's env file without touching this .env (API_ENV_FILE: REG / API configs
#                        # only, never the smoke suite); a named file that does not exist stops the run
# REG_RUN_ID=            # default qa-reg-<yyyymmdd>-<hhmmss>-<4 random base36>; reuse an id to reuse that run's objects
#                        # (a hand-set id must have that format and keeps its objects unless API_DELETE_OWN=1)
# REG_RUN_ID_REUSE=      # 1: admit a hand-set REG_RUN_ID of an older shape (qa-reg-[a-z0-9-]+)
# REG_STATE_DIR=         # run state, ledger, snapshots, cleanup ledger (default ~/.ilm-qa/regression-state)
# TIER_KIND=             # local = disposable local stack (enables @local rows); unset = shared tier. Frozen at config load.
# REG_LOCAL_CORE_URL=    # TIER_KIND=local only: the local core's base URL (loopback / private); /api/v1/info must answer
#                        # with a build marker (version + commit id or build time) at load, a running docker container
#                        # must publish its port, and the setup compares that marker with BASE_URL's /api/v1/info read
#                        # with the run's authentication, then reads a role it created through BASE_URL back through
#                        # this URL with AUTH_CLIENT_CERT (required for TIER_KIND=local), and finally from INSIDE the
#                        # container that publishes the port (`docker exec … curl | wget`; the core image needs one of
#                        # them). The published port must be bound to 0.0.0.0 / [::] / 127.x / ::1 for a loopback core.
# LOCAL_COMPOSE_PROJECT= # optional: the container publishing the core port must carry this compose project label; the local-stack
#                        # helpers and the container proof both read it (the alias REG_LOCAL_COMPOSE_PROJECT is read too; the first one set wins)
# TIER_LOCAL_HOSTS=      # extra hosts accepted as a local stack with TIER_KIND=local / AUTH_MODE=header (comma-separated);
#                        # each must be an RFC 1918 / link-local address or resolve only to such addresses
#                        # (for a stack on another machine, DOCKER_HOST — or the current docker context — must point at
#                        # that host's daemon; a private core host that is neither this machine nor that daemon's host
#                        # is refused; a TCP / SSH endpoint on loopback such as tcp://localhost:2375 counts only when its
#                        # daemon ID equals the local socket's: a tunnel looks the same)
# API_DELETE_OWN=        # default 1 (0 for a hand-set REG_RUN_ID): delete the run's own objects at the end; 0 keeps them
# API_TEARDOWN_DRY_RUN=  # 1: the run-end teardown prints its plan and deletes nothing
# REG_KEPT_STRICT=       # 1: objects the teardown kept (derived, provably older than the run, or adopted) fail the run;
#                        # default: warnings plus $REG_STATE_DIR/<run id>.kept.json
#                        # switches accept 1/true/yes/on and 0/false/no/off; any other value stops the run
# REG_NET_TOLERANCE=     # API-GEN-33 net accounting: allowed unexplained change of a total (default 0)
# CLEANUP_LEDGER_FILE=   # default $REG_STATE_DIR/<run id>.cleanup.jsonl for REG / API runs
# REG_BUILD=             # sb41 = Spring Boot 4.1 build, main = baseline; unset: read build.branch from /v1/info
# REG_PHASE=             # B: run only the @phaseB rows (migrated connectors)
# REG_CORE_REPLICAS=     # core replica count of the tier (multi-replica rows)
# REG_SCAN_HOST=         # host the discovery rows scan (runner-hosted TLS targets)
# REG_SCAN_BIND=         # address the runner-hosted TLS scan targets listen on (default 0.0.0.0); REG_SCAN_HOST is the name the connector dials
# REG_DISCOVERY_V1_CONNECTOR= # discovery connector registered as v1 (name); default: the first healthy registration with the IP-Hostname kind
# REG_DISCOVERY_V2_CONNECTOR= # discovery connector registered as v2 (name); default: the first healthy registration offering the certificates resource
# REG_SMTP_CATCHER_URL=  # local notification overlay only: HTTP API of the mail catcher (Mailpit); the e-mail instances send to its SMTP port
# REG_WEBHOOK_HOST=      # local notification overlay only: dotted alias of the runner the webhook provider container can reach
# REG_WEBHOOK_BIND=      # address the runner-hosted webhook receiver listens on (default 0.0.0.0)
# REG_RESTRICTED_USERNAME= # second identity for the RBAC rows (blocked until DevOps provides the account)
# REG_RESTRICTED_PASSWORD=
# REG_OPENSSL_BIN= REG_SSCEP_BIN= REG_DOCKER_BIN= REG_KUBECTL_BIN=  # runner tools (default: from PATH)
# REG_ADCS_CONNECTOR=MS-ADCS-NG-Connector
# REG_ADCS_SOURCE_AUTHORITY=   # existing NG authority whose CA host / name are copied (default: first connected one)
# REG_ADCS_TEMPLATE=     # AD CS template id (e.g. WebServer); default: the template of an RA profile on the source
# REG_CREDENTIAL_CONNECTOR=Common-Credential-Connector
# REG_REQUIRED_CONNECTORS=Common-Credential-Connector,MS-ADCS-NG-Connector
# REG_BLOCKED_CONNECTORS=      # name:reason;… — REG-DEP-01.d skips that connector with the named environment blocker
# REG_GATE_CONNECTOR=          # API-GEN-32[connector]: the connector of the attribute round trip (default: the first required)
# REG_CA_CONNECTORS=MS-ADCS-NG-Connector,EJBCA-NG-Connector,PyADCS-Connector  # CA order of the run RA profile (live health)
# REG_EXACT_SAN_CONNECTORS=EJBCA-NG-Connector  # CAs whose issued SAN set must equal the CSR's (else: DNS values only)
# REG_EXPECTED_CORE_VERSION=   # release check: exact versions expected on the tier
# REG_EXPECTED_FE_VERSION=
# REG_STRICT_VERSIONS=false    # true: fail when core and frontend major.minor differ
# REG_USER_PASSWORD=     # IdP password of the user REG-CFG-09 creates (enables the login check)
# REG-USE-06 cert-manager (skipped unless set): KUBECONFIG, REG_CM_NAMESPACE, REG_CM_AUTH_SECRET,
# REG_CM_CA_BUNDLE_SECRET (optional), REG_CM_API_URL (optional); its issuer, Certificate and Secret are run-prefixed,
# recorded as k8s:<Kind> ledger lines and removed by the spec's afterAll
# Local development stack (ilm#424): TIER_KIND=local, REG_LOCAL_CORE_URL = the local core, AUTH_MODE=header (loopback /
# private TIER_LOCAL_HOSTS BASE_URL only), BASE_URL = frontend dev server, AUTH_CLIENT_CERT =
# URL-encoded Base64 admin certificate (needed when calling core directly, and by the TIER_KIND=local instance proof);
# REG_RA_PROFILE_NAME = an existing enabled RA profile (e.g. EJBCA) used as an issue-only parent instead of creating the
# run's own RA profile (honoured only with TIER_KIND=local; nothing on it is activated or changed: protocol activation uses
# an own clone). REG-CFG-02/03 skip when no MS ADCS connector is connected and live (health by version).
# AUTH_CLIENT_CERT=
# REG_RA_PROFILE_NAME=

# Protocols area: the software cryptography provider F-CA is built on (optional; default: a v2 provider, then v1)
# REG_SOFT_PROVIDER=

# Inventory area: the published OpenAPI document of the build under test (API-GEN-23 / 24 / 25 skip without it)
# REG_OPENAPI_FILE=

# Platform area: all optional
# REG_CRYPTO_CONNECTOR_V2=   # software cryptography connector (v2) name; default Software-Cryptography-Provider-v2, else detection by function group
# REG_CRYPTO_CONNECTOR_V1=   # v1 name; default Software-Cryptography-Provider
# REG_SECRET_CONNECTOR=      # connector with a secret interface; default Common-Credential-Connector-v2, else the first connected one
# REG_PKCS11_CONNECTOR=      # default PKCS11-Cryptography-Provider
# REG_STUB_ADVERTISED_HOST=  # host the connector dials for the runner-hosted stub (default host.docker.internal)
# REG_STUB_BIND_HOST=        # address the stub listens on (127.0.0.1 default; 0.0.0.0 allowed)
# REG_UPGRADE_FROM_TAG=      # REG-DEP-02: the older image tag the local stack upgrades from
# LOCAL_COMPOSE_FILE=        # local stack only: compose file (REG-CORE-01 / 02, REG-DEP-02); the alias REG_LOCAL_COMPOSE_FILE is read too (the first one set wins)
# LOCAL_COMPOSE_FILE_TARGET= # REG-DEP-02: the compose file pinning the image under test
# LOCAL_SERVICE_CORE= / LOCAL_SERVICE_RABBITMQ= / LOCAL_SERVICE_DB= / LOCAL_SERVICE_AUTH= / LOCAL_SERVICE_SCHEDULER=   # compose service names (the core one has the alias REG_LOCAL_SERVICE_CORE)
# REG_LOCAL_COMPOSE_FILE= / REG_LOCAL_COMPOSE_PROJECT=   # aliases of LOCAL_COMPOSE_FILE / LOCAL_COMPOSE_PROJECT
# REG_DOCKER_BIN=            # docker binary used by the local-stack helpers

# === Developers' blocks (playwright.devblock.config.ts; DEV_BLOCK picks one) ===
# DEV_BLOCK=                    # timestamping | key-onboarding (required for the dev-block config; unset stops before listing)
# key-onboarding is @local only (SoftHSM sidecar). Names only below; never put a real PIN into this file.
# KO_TOKEN_PIN=                 # SoftHSM user PIN (required; no default). Goes through the environment, never on a command line.
# KO_SIDECAR_CONTAINER=         # default pkcs11-sidecar-softhsm
# KO_PKCS11_TOKEN=              # default softhsm
# KO_PKCS11_PROFILE=            # default softhsm
# KO_PKCS11_CONNECTOR_URL=      # default http://localhost:8290
# KO_VAULT_CONNECTOR_URL=       # default http://localhost:8200
# timestamping (TSA_*) is documented in tests/timestamping/; leave those unset on develop-01 until that block is enabled.

# Set by the run, never by the user (workers and child processes read them): REG_TIER_ID (the frozen tier identity),
# REG_ENV_FILE_PINNED (the env file the config pinned), REG_LOCAL_CORE_MARKER (the core build marker the local proof read),
# REG_PROOF_CERT (the proof certificate handed to a docker child), REG_UNIT_NO_DOCKER (the unit config: the real docker is never run),
# API_RUN_ID (always the REG_RUN_ID of the run, for the helpers generated from the API test template).
